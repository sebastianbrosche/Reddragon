#!/usr/bin/expect -f
set timeout 120
set logfile "/root/.openclaw/workspace/mud/iom_emalz_archive/grind_main.log"
set statusfile "/root/.openclaw/workspace/mud/iom_emalz_archive/grind_status.txt"

exec rm -f $logfile
log_file $logfile

spawn telnet islandsofmyth.org 3000

# Login
expect "Please enter a name"
send "emalz\r"
expect "Password:"
send "creative\r"

# Wait for prompt
expect ">"

# Check initial state
send "score\r"
expect ">"
send "skills\r"
expect ">"

# Navigate to Yensid Land via Sisong
send "warp\r"
expect ">"
send "se\r"
expect ">"
send "e\r"
expect ">"
send "talk sisong\r"
expect "Sisong's Newbie Information"
send "2\r"
expect "Newbie Areas"
send "9\r"
expect "Would you like to visit the Yensid Land?"
send "Y\r"
expect ">"

# Enable combat silence
send "combat silence\r"
expect ">"

# Navigate to LobeLands (where earwigs are)
send "e\r"
expect ">"
send "ne\r"
expect ">"
send "n\r"
expect ">"
send "look\r"
expect ">"

# Write status file indicating start
set fp [open $statusfile w]
puts $fp "GRIND_START: [exec date]"
puts $fp "TARGET: Level 15"
puts $fp "CURRENT: Level 5"
close $fp

# Main grind loop - kill earwigs
set i 0
while {$i < 200} {
    incr i
    
    # Kill first earwig
    send "kill earwig\r"
    sleep 12
    expect {
        ">" {}
        timeout { send "\r"; sleep 2; expect ">" }
    }
    
    # Check HP - if low, rest
    send "score\r"
    sleep 2
    expect ">"
    
    # Every 10 kills, do a full check and update status
    if {$i % 10 == 0} {
        send "score\r"
        expect ">"
        send "skills\r"
        expect ">"
        
        set fp [open $statusfile a]
        puts $fp "KILL_BATCH_$i: [exec date]"
        close $fp
    }
    
    # Brief pause between kills to let things respawn
    sleep 3
}

# Final checks
send "score\r"
expect ">"
send "skills\r"
expect ">"

# Write completion status
set fp [open $statusfile a]
puts $fp "GRIND_END: [exec date]"
puts $fp "TOTAL_KILLS: $i"
close $fp

# Save and quit
send "quit\r"
sleep 3
expect "Save"
send "Y\r"

puts "GRINDING SESSION COMPLETE"
